{
  "name": "suncoast-crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral CRM API with durable Kafka delivery",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/api.ts",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
